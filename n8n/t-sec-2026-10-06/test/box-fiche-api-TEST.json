      "id": "gd_set",
      "name": "Download Fiche",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        960,
        -100
      ],
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "cukxQDNwWIqOAK02",
          "name": "Google Drive la bonne!"
        }
      },
      "notes": "Telecharge le fichier JSON de la fiche depuis Google Drive. Le file_id est passe en query param par le frontend."
    },
    {
      "parameters": {
        "jsCode": "const buffer = await this.helpers.getBinaryDataBuffer(0, 'data');\nconst fiche = JSON.parse(buffer.toString('utf-8'));\n\n// Retirer les champs sensibles avant envoi au frontend\ndelete fiche.prof_email;\ndelete fiche.code_suppression;\n\nreturn [{ json: fiche }];"
      },
      "id": "code_set",
      "name": "Parse et nettoyer",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
