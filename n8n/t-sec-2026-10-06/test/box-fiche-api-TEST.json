      "id": "gd_catalogue",
      "name": "Download Catalogue (TEST)",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        240,
        0
      ],
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "cukxQDNwWIqOAK02",
          "name": "Google Drive la bonne!"
        }
      },
      "notes": "Pointe sur la copie de test du catalogue (CATALOGUE_TEST_ID a remplacer par Eric). Lecture seule, rien n'est jamais ecrit ici."
    },
    {
      "parameters": {
        "jsCode": "const fileId = $('Webhook').first().json.query.file_id || '';\n\nlet catalogue;\ntry {\n  const buffer = await this.helpers.getBinaryDataBuffer(0, 'data');\n  let parsed = JSON.parse(buffer.toString('utf-8'));\n  if (typeof parsed === 'string') parsed = JSON.parse(parsed);\n  catalogue = (parsed && Array.isArray(parsed.sets)) ? parsed : { sets: [] };\n} catch (e) {\n  catalogue = { sets: [] };\n}\n\nconst publie = fileId !== '' && catalogue.sets.some((s) => s.drive_file_id === fileId);\n\nreturn [{ json: { file_id: fileId, publie } }];"
      },
      "id": "code_verif_pub",
      "name": "Verifier publication",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "version": 2,
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.publie }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ]
        },
        "options": {}
      },
