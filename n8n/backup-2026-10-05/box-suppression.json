      "id": "gd_dl_cat",
      "name": "Download Catalogue",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [240, 0],
      "credentials": { "googleDriveOAuth2Api": { "id": "cukxQDNwWIqOAK02", "name": "Google Drive la bonne!" } },
      "notes": "CONFIGURER : remplacer CATALOGUE_FILE_ID par l'ID du fichier catalogue.json"
    },
    {
      "parameters": {
        "jsCode": "const webhookData = $('Webhook').first().json.body;\nconst buffer = await this.helpers.getBinaryDataBuffer(0, 'data');\nconst catalogue = JSON.parse(buffer.toString('utf-8'));\n\nconst setId = webhookData.set_id;\nconst code = webhookData.code_suppression;\n\n// Trouver le set dans le catalogue\nconst setIndex = catalogue.sets.findIndex(s => s.id === setId);\nif (setIndex === -1) {\n  return [{ json: { found: false, error: 'Jeu introuvable' } }];\n}\n\nconst setInfo = catalogue.sets[setIndex];\n\n// On doit verifier le code dans le fichier JSON du set\nreturn [{\n  json: {\n    found: true,\n    set_id: setId,\n    code_suppression: code,\n    drive_file_id: setInfo.drive_file_id,\n    set_index: setIndex,\n    catalogue: catalogue\n  }\n}];"
      },
      "id": "code_find",
      "name": "Trouver et verifier",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "version": 2, "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "combinator": "and",
          "conditions": [{ "id": "cond1", "leftValue": "={{ $json.found }}", "rightValue": true, "operator": { "type": "boolean", "operation": "equals" } }]
        },
        "options": {}
      },
      "id": "if_found",
      "name": "Set trouve ?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [720, 0]
    },
    {
      "parameters": {
        "operation": "download",
        "fileId": { "__rl": true, "mode": "id", "value": "={{ $json.drive_file_id }}" },
        "options": {}
      },
      "id": "gd_dl_set",
      "name": "Download Set",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [960, -96],
      "credentials": { "googleDriveOAuth2Api": { "id": "cukxQDNwWIqOAK02", "name": "Google Drive la bonne!" } }
    },
    {
      "parameters": {
        "jsCode": "const prevData = $('Trouver et verifier').first().json;\nconst buffer = await this.helpers.getBinaryDataBuffer(0, 'data');\nconst fiche = JSON.parse(buffer.toString('utf-8'));\n\nif (fiche.code_suppression !== prevData.code_suppression) {\n  return [{ json: { verified: false, error: 'Code incorrect' } }];\n}\n\n// Code OK : preparer la suppression\nconst catalogue = prevData.catalogue;\ncatalogue.sets.splice(prevData.set_index, 1);\ncatalogue.total_sets = catalogue.sets.length;\ncatalogue.last_updated = new Date().toISOString();\n\nreturn [{\n  json: {\n    verified: true,\n    drive_file_id: prevData.drive_file_id,\n    updated_catalogue: JSON.stringify(catalogue, null, 2)\n  }\n}];"
      },
      "id": "code_verify",
